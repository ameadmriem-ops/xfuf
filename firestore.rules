rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /movies/{movieId} {
      // Allow reading movies/series/anime across the app
      allow read: if true;

      // Allow creating or deleting content only when adminKey is verified
      allow create: if request.resource.data.adminKey == "hamza2009";
      allow delete: if true;

      // Allow updating poster or episodes only when valid adminKey is provided and poster is a non-empty string
      allow update: if request.resource.data.poster is string
                    && request.resource.data.poster.size() > 0
                    && (
                      request.resource.data.adminKey == "hamza2009"
                      || !request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poster'])
                    );
    }

    match /fcm_devices/{deviceId} {
      allow read: if true;
      allow create, update: if request.resource.data.token is string
                            && request.resource.data.token.size() > 0;
    }

    match /app_notifications/{notifId} {
      allow read: if true;
      // Only Admin with verified adminKey can create broadcast notifications
      allow create: if request.resource.data.adminKey == "hamza2009"
                    && request.resource.data.title is string
                    && request.resource.data.body is string;
      // Allow Admin updates or client delivery receipt updates (deliveredDevices / deliveredCount)
      allow update: if request.resource.data.adminKey == "hamza2009"
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredDevices', 'deliveredCount']);
      allow delete: if true;
    }
  }
}
